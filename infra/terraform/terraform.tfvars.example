# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Every value below has a default in variables.tf - override only what you need.

aws_region   = "ap-south-1"
project_name = "shanvi-bmp"
environment  = "prod"

# Repository connection is not managed here - connect it once by hand in the
# Amplify console (App > branch settings > "Connect branch"). See
# infra/README.md for why, and how to bring it under Terraform afterward.
