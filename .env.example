# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already git-ignored) and never commit real secrets anywhere else.

# Postgres connection string, e.g.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public
# In production this points at the RDS instance provisioned by
# infra/terraform (see its output "database_url_hint"); locally, point it at
# your own Postgres instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_management_platform?schema=public"

# Secret key used to sign/verify session JWTs (see src/lib/auth/session.ts).
# Must be a long, random, unguessable string (at least 32 characters
# recommended) and unique per environment - generate one with, e.g.:
#   openssl rand -base64 48
# Rotating this value invalidates every existing session (all users are
# signed out), so change it deliberately, not casually.
SESSION_SECRET="replace-with-a-long-random-value"

# Document storage (src/lib/core/storage). Leave AWS_S3_BUCKET unset to use
# local disk (zero setup, dev default). Set it to switch to S3 - required in
# production, since a serverless/managed host has no persistent local disk.
# AWS_REGION defaults to us-east-1 if unset. Credentials are never read from
# here - in production Amplify's IAM role provides them; locally, whatever
# `aws configure` / AWS_ACCESS_KEY_ID+AWS_SECRET_ACCESS_KEY you have set.
# AWS_S3_BUCKET="business-management-platform-documents-prod"
# AWS_REGION="us-east-1"
