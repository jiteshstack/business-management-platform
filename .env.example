# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already git-ignored) and never commit real secrets anywhere else.

# SQLite connection string. Prisma resolves a relative "file:" path against
# the prisma/ directory, not the process working directory - the default
# below is correct for local development as-is.
DATABASE_URL="file:./dev.db"

# Secret key used to sign/verify session JWTs (see src/lib/auth/session.ts).
# Must be a long, random, unguessable string (at least 32 characters
# recommended) and unique per environment - generate one with, e.g.:
#   openssl rand -base64 48
# Rotating this value invalidates every existing session (all users are
# signed out), so change it deliberately, not casually.
SESSION_SECRET="replace-with-a-long-random-value"
